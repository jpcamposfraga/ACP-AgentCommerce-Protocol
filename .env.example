# Environment
ENV=development
PORT=8000

# Database (PostgreSQL)
POSTGRES_USER=acp_user
POSTGRES_PASSWORD=acp_secure_password
POSTGRES_DB=acp_database
DATABASE_URL=postgresql+asyncpg://acp_user:acp_secure_password@localhost:5432/acp_database

# Redis
REDIS_URL=redis://localhost:6379/0

# Platform Settings
ACP_PLATFORM_FEE_PCT=0.02
ACP_MIN_CHECK_INTERVAL_SECONDS=60

# Banking as a Service (BaaS - Sandbox)
ASAAS_API_KEY=mock_sandbox_key
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
